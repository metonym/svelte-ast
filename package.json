{
  "name": "svelte-ast",
  "version": "0.12.1",
  "description": "svelte/compiler's AST, 2.4\u00d7 faster, with zero dependencies.",
  "license": "MIT",
  "author": "Eric Liu (https://github.com/metonym)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metonym/svelte-ast.git"
  },
  "homepage": "https://github.com/metonym/svelte-ast",
  "bugs": "https://github.com/metonym/svelte-ast/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./a11y": {
      "types": "./a11y.d.ts",
      "default": "./a11y.js"
    },
    "./core": {
      "types": "./core.d.ts",
      "default": "./core.js"
    },
    "./walk": {
      "types": "./walk.d.ts",
      "default": "./walk.js"
    },
    "./lexer": {
      "types": "./lexer.d.ts",
      "default": "./lexer.js"
    },
    "./scope": {
      "types": "./scope.d.ts",
      "default": "./scope.js"
    },
    "./module": {
      "types": "./module.d.ts",
      "default": "./module.js"
    },
    "./entities": {
      "types": "./entities.d.ts",
      "default": "./entities.js"
    },
    "./warnings": {
      "types": "./warnings.d.ts",
      "default": "./warnings.js"
    },
    "./typescript": {
      "types": "./typescript.d.ts",
      "default": "./typescript.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false
}
